  "narrative": {
    "northStar": "消息派活，工具独立，工作连续",
    "overview": "视觉基准为 images 中的新版社团对话界面、新版查证浏览器和新版问问ai。沿用参考图的浅蓝背景、白色全宽面板、顶部切换、左右聊天气泡、附件入口和底部输入栏。新增工作台承载编辑与提交，四个任务共用同一框架。",
    "keyCharacteristics": [
      "社团聊天只处理沟通与附件跳转。",
      "查证浏览器拥有独立网页标签、导航和地址栏。",
      "AI 对话拥有任务上下文与独立输入栏。",
      "工作台处理材料阅读、编辑、最终判断和提交。"
    ],
    "rules": [],
    "dos": [
      "Do 保留三张新版图中的导航、气泡、附件与输入栏关系。",
      "Do 保留文字标签，不用图标替代入口含义。",
      "Do 让聊天、网页、AI 与任务编辑保持独立。"
    ],
    "donts": [
      "Don't 把任务表单和查证页面再次塞进聊天侧栏。",
      "Don't 重新引入旧任务页、抽屉或重复样式。",
      "Don't 把仿真信源、问卷草案或项目参考等级标为官方已验证结果。"
    ]
  }
