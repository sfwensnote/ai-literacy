  "narrative": {
    "northStar": "安静而连续的社团工作台",
    "overview": "在既有蓝白视觉中扩展情境任务。主要操作与角色消息并列，浏览器和提交物保持可见。首页继续使用原有布局与样式，本文件新增规范适用于任务、问卷、分析与反馈。",
    "keyCharacteristics": [
      "全宽利用空间，不使用居中的窄任务卡。",
      "内容决定密度，不用重复提示和空卡片占位。",
      "角色消息推动任务，反馈报告解释已记录的行为。"
    ],
    "rules": [],
    "dos": [
      "Do 保留首页原有视觉与内容。",
      "Do 用统一的字体层级和紧凑间距覆盖测评页面。",
      "Do 保留可见焦点、真实标签、手机单栏和无横向溢出的布局。"
    ],
    "donts": [
      "Don't 在任务中暴露分数或正确答案。",
      "Don't 将仿真数据、原创建议问卷或项目等级标为官方或已验证结果。"
